# [TINIX] Copy this file to service/.env and fill in the values.
# service/.env is git-ignored — never commit it.

# Secret used to sign login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it logs you out (old tokens become invalid).
AUTH_SECRET=

# API server address & port. 127.0.0.1 = only this computer can connect.
HOST=127.0.0.1
PORT=7001

# Only used the very first time, when the database has no users yet.
# DEFAULT_ADMIN_ACCOUNT=admin
# DEFAULT_ADMIN_PASSWORD=
