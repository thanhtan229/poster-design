{
  "name": "xunpai-design",
  "version": "2.0.0",
  "private": true,
  "author": "ShawnPhang",
  "scripts": {
    "tinix:setup": "npm i && npm --prefix service i",
    "tinix:dev": "node scripts/tinix-dev.mjs",
    "tinix:prod": "node scripts/tinix-prod.mjs",
    "tinix:fonts": "node scripts/tinix-import-fonts.mjs",
    "tinix:font-previews": "node scripts/tinix-font-previews.mjs",
    "tinix:winfonts": "node scripts/tinix-winfonts.mjs",
    "tinix:backup": "node scripts/tinix-backup.mjs",
    "tinix:test-ai": "node scripts/tinix-ai-selftest/index.cjs",
    "tinix:test": "node scripts/tinix-test.cjs",
    "tinix:typecheck-service": "node scripts/tinix-typecheck-service.cjs",
    "tinix:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tinix-shortcut.ps1",
    "prepared": "npm i && cd service && PUPPETEER_DOWNLOAD_BASE_URL=https://cdn.npmmirror.com/binaries/chrome-for-testing npm i",
    "serve": "npm run dev & cd service && npm run dev",
    "dev": "cross-env NODE_ENV=development vite",
    "build": "cross-env NODE_ENV=production && vite build",
    "v-build": "cross-env NODE_ENV=production && vite build",
    "v-build-hard": "cross-env NODE_ENV=production vue-tsc --noEmit && vite build",
    "lint": "eslint --ext .ts,.vue src",
    "tinix:test-ui": "node scripts/tinix-ui-test.cjs",
    "tinix:normalize-fonts": "node scripts/tinix-normalize-fonts.mjs",
    "tinix:test-ui:selection": "node scripts/tinix-ui-test.cjs selection",
    "tinix:test-ui:menu": "node scripts/tinix-ui-test.cjs menu",
    "tinix:test-ui:arrangement": "node scripts/tinix-ui-test.cjs arrangement",
    "tinix:test-ui:undo": "node scripts/tinix-ui-test.cjs undo",
    "tinix:test-font-ui": "node scripts/tinix-selftest/visual-font-ui.cjs",
    "tinix:test-font-review-app": "node scripts/tinix-font-review-app.cjs",
    "tinix:test-font-review-ui": "node scripts/tinix-selftest/font-review-ui.cjs",
    "tinix:font-real-cases": "node scripts/tinix-font-real-cases.cjs",
    "tinix:font-real-quality": "node scripts/tinix-font-real-quality.cjs",
    "tinix:font-quality-expanded": "node scripts/tinix-font-quality-expanded.cjs",
    "tinix:font-quality-fixtures": "node scripts/tinix-font-quality-fixtures.cjs",
    "tinix:font-quality": "node scripts/tinix-font-quality.cjs"
  },
  "dependencies": {
    "@bunnio/rembg-web": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@palxp/color-picker": "workspace:*",
    "@palxp/image-extraction": "workspace:*",
    "@scena/guides": "^0.18.1",
    "ag-psd": "^34.1.0",
    "axios": "^1.21.1",
    "core-js": "^3.6.5",
    "cropperjs": "^1.6.1",
    "dayjs": "^1.10.7",
    "element-plus": "^2.14.8",
    "fontfaceobserver": "^2.1.0",
    "html2canvas": "^1.4.1",
    "immer": "^10.0.4",
    "microdiff": "^1.4.0",
    "mitt": "^3.0.1",
    "moveable": "^0.26.0",
    "moveable-helper": "^0.4.0",
    "nanoid": "^3.1.23",
    "normalize.css": "^8.0.1",
    "onnxruntime-web": "^1.29.0",
    "pinia": "^2.1.7",
    "psd.js": "^3.9.0",
    "qr-code-styling": "^1.6.0-rc.1",
    "selecto": "^1.13.0",
    "throttle-debounce": "^3.0.1",
    "vite-plugin-compression": "^0.5.1",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^4.0.0-0",
    "vuedraggable": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cropperjs": "^1.3.0",
    "@types/fontfaceobserver": "^2.1.3",
    "@types/node": "^20.11.24",
    "@types/throttle-debounce": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "autoprefixer": "^10.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-alloy": "~4.1.0",
    "eslint-plugin-vue": "^9.33.0",
    "less": "^4.1.1",
    "terser": "^5.28.1",
    "typescript": "^5.2.2",
    "unplugin-element-plus": "^0.7.1",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "workspaces": [
    "packages/*"
  ],
  "browserslist": [
    "Chrome >= 90"
  ],
  "website": "https://design.palxp.cn",
  "homepage": "https://xp.palxp.cn",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
